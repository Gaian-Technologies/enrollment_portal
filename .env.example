ENROLLMENT_PORTAL_BIND_HOST=127.0.0.1
ENROLLMENT_PORTAL_BIND_PORT=8100
ENROLLMENT_PORTAL_PUBLIC_BASE_URL=https://hub.example.com
ENROLLMENT_PORTAL_SITE_NAME=Gaian Telemetry
ENROLLMENT_PORTAL_HUB_ADMIN_API_URL=http://127.0.0.1:8000/api/v1/admin/invites
ENROLLMENT_PORTAL_HUB_ADMIN_TOKEN=replace-with-a-strong-admin-token
ENROLLMENT_PORTAL_DB_FILE=/app/var/access_requests.sqlite3
ENROLLMENT_PORTAL_VERIFICATION_TTL_MINUTES=30
ENROLLMENT_PORTAL_INVITE_EXPIRES_HOURS=1
ENROLLMENT_PORTAL_RATE_LIMIT_PER_IP_PER_HOUR=10
ENROLLMENT_PORTAL_RATE_LIMIT_PER_EMAIL_PER_HOUR=3
AWS_PROFILE=deployment
AWS_REGION=us-east-1
ENROLLMENT_PORTAL_SES_FROM_EMAIL=no-reply@example.com
ENROLLMENT_PORTAL_SES_CONFIGURATION_SET=
ENROLLMENT_PORTAL_TURNSTILE_SITE_KEY=1x00000000000000000000AA
ENROLLMENT_PORTAL_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Replace the Turnstile test keys with a real widget before public rollout.
# For local Docker testing, mount ~/.aws and point AWS_PROFILE at the
# deployment-capable named profile.
# On EC2, leave AWS_PROFILE empty and use the instance role instead.
# Optional direct environment credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
